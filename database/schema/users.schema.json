{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "description": "A registered customer or admin of Khang restaurant",
  "type": "object",
  "required": ["name", "email", "password"],
  "properties": {
    "_id": { "type": "string", "description": "Mongo ObjectId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Unique, lowercased"
    },
    "phone": { "type": "string" },
    "password": {
      "type": "string",
      "minLength": 6,
      "description": "bcrypt hashed (10 rounds), never returned in API responses"
    },
    "role": {
      "type": "string",
      "enum": ["user", "admin"],
      "default": "user"
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "default": "Home" },
          "line1": { "type": "string" },
          "line2": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "pincode": { "type": "string" },
          "isDefault": { "type": "boolean", "default": false }
        }
      }
    },
    "favourites": {
      "type": "array",
      "items": { "type": "string", "description": "Product ObjectId references" }
    },
    "avatarUrl": { "type": "string", "format": "uri" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
