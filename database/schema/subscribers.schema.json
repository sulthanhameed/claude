{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Subscriber",
  "description": "An email captured by the footer newsletter form",
  "type": "object",
  "required": [
    "email"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "description": "Mongo ObjectId"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Unique, lowercased"
    },
    "source": {
      "type": "string",
      "default": "footer"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "subscribedAt": {
      "type": "string",
      "format": "date-time"
    },
    "unsubscribedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
