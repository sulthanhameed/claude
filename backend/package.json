{
  "name": "khang-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB API for Khang Chinese Restaurant — Razorpay payments and email order notifications",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:force": "node src/scripts/seed.js --force"
  },
  "keywords": [
