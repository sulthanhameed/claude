# ─────────────────────────────────────────────────
# Khang Backend — Environment Variables
# Copy to `.env` and fill in the values.
# ─────────────────────────────────────────────────

# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Frontend origin(s). Comma-separated for multiple domains.
# Leave `*` for local development.
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas or local) ────────────
# Atlas example:
# mongodb+srv://khang:<password>@cluster0.xxxxx.mongodb.net/khang?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/khang
MONGO_AUTO_INDEX=true

# ── Auth ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Razorpay ─────────────────────────────────────
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional but recommended: Dashboard → Settings → Webhooks
# URL: https://your-api.onrender.com/api/payments/razorpay/webhook
# Event: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Email (Gmail App Password recommended) ───────
# 1. Enable 2-Step Verification on the Google account
# 2. Google Account → Security → App passwords → create "Mail"
# 3. Paste the 16-character password below (no spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=sultham456@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_FROM="Khang Restaurant <sultham456@gmail.com>"

# Every order is emailed here + a receipt goes to the customer.
ORDER_NOTIFY_EMAIL=sultham456@gmail.com

# ── Admin account (used by `npm run seed`) ───────
ADMIN_NAME=Khang Admin
ADMIN_EMAIL=admin@khang.com
ADMIN_PASSWORD=change-this-password
# Set true once to overwrite an existing admin password on the next seed
ADMIN_RESET_PASSWORD=false
