# ─────────────────────────────────────────────────
# Khang Frontend — Environment Variables
# Copy to `.env` for local development.
# ─────────────────────────────────────────────────

# Leave empty (or unset) during local development:
# Vite proxies /api → http://localhost:5000 automatically.
VITE_API_URL=/api

# Optional: change the local proxy target if the API runs elsewhere.
VITE_PROXY_TARGET=http://localhost:5000

# ── Production (Vercel / Netlify) ─────────────────
# Set this in the hosting dashboard, e.g.:
# VITE_API_URL=https://khang-api.onrender.com/api
