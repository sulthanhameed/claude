# ─────────────────────────────────────────────────
# Khang Frontend — Environment Variables
# Copy to `.env` for local development.
# ─────────────────────────────────────────────────

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# ── local preview only ────────────────────────────────────────────────
# Leave the Supabase values empty to run the UI against the local mock:
#   npm run mock                    # :5000
# Vite proxies /api → http://localhost:5000 (see vite.config.ts).
# Production builds require the two Supabase values above.
# VITE_PREVIEW_API=/api
# VITE_PROXY_TARGET=http://localhost:5000
