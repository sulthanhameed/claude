# ─────────────────────────────────────────────────
# Khang Frontend — Environment Variables
# Copy to `.env` for local development.
# ─────────────────────────────────────────────────

# Supabase project: nnyokeivsnvbbxzfqexf
# Dashboard → Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=https://nnyokeivsnvbbxzfqexf.supabase.co
# Paste the anon public key after the "=" — the build stays on the mock until
# both of these are filled in, so a half-finished .env never fails silently.
VITE_SUPABASE_ANON_KEY=

# ── local preview only ────────────────────────────────────────────────
# Leave the two values above empty to run the UI against the local mock:
#   npm run mock                    # :5000
# Vite proxies /api → http://localhost:5000 (see vite.config.ts).
# Production builds require the two Supabase values above.
# VITE_PREVIEW_API=/api
# VITE_PROXY_TARGET=http://localhost:5000
