# ─────────────────────────────────────────────────
# Khang Edge Functions — local secrets
# Copy to `supabase/functions/.env` (git-ignored) before:
#   supabase functions serve
# In a hosted project, set the same names with:
#   supabase secrets set --env-file supabase/functions/.env
# The SUPABASE_* keys are injected by the platform — never set them here.
# ─────────────────────────────────────────────────

# Razorpay (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret (Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Resend — order emails are skipped, not failed, without it
RESEND_API_KEY=
EMAIL_FROM=Khang Restaurant <onboarding@resend.dev>

# Where the kitchen copy of every order goes
ORDER_NOTIFY_EMAIL=sultham456@gmail.com
